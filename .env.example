# =====================================================
# Server
# =====================================================
PORT=3000
NODE_ENV=development

# Encryption key para tokens de integraciones (TN, Meta, Shopify, Resend).
# Debe ser una cadena HEX de 64 chars (32 bytes). Generala con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# CRÍTICO: si la perdés, todos los tokens cifrados quedan inservibles y el
# equipo tiene que re-conectar cada integración.
ENCRYPTION_KEY=

# JWT
JWT_SECRET=change-this-to-a-random-secret-long-enough

# CORS — lista separada por comas de orígenes permitidos. Sin esta var, en
# dev acepta todo. En prod, setear con el dominio público del frontend.
# Ejemplo: CORS_ORIGIN=https://hooks.tudominio.com
CORS_ORIGIN=

# URL pública de la app (frontend). Se usa para armar links de invitación,
# acceso a re-conexión de tokens, etc. en los emails.
APP_PUBLIC_URL=http://localhost:5173

# Versión del app — opcional, se incluye en reportes de Sentry.
APP_VERSION=

# =====================================================
# MongoDB
# =====================================================
# Hardening recomendado en producción:
#  1. Atlas → Network Access: borrar 0.0.0.0/0 y agregar:
#     - IP de Railway (Static IP del proyecto)
#     - IP del admin (tu IP)
#  2. Atlas → Database Access: crear un user con scope minimal
#     (no usar root). Permisos: readWrite a la DB específica.
#  3. Atlas → Backups: verificar que estén activos (cluster M10+ los
#     trae automáticos; M0/M2/M5 hay que activarlos manualmente o
#     correr snapshots con el script `mongodump`).
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/ecom-analytics

# =====================================================
# TiendaNube (OAuth app)
# =====================================================
TN_APP_ID=
TN_APP_SECRET=
TN_CALLBACK_URL=

# Token central de "cro_service" (opcional, sólo para tiendas del equipo)
CRO_SERVICE_API_URL=https://app.ecomclub.com.ar/api/service/stores
CRO_SERVICE_API_KEY=

# =====================================================
# Meta Ads (OAuth app)
# =====================================================
META_APP_ID=
META_APP_SECRET=
META_CALLBACK_URL=

# =====================================================
# Email (Resend)
# =====================================================
# API key global de la app. Cada user puede traer la suya (User.resendApiKey)
# que toma precedencia. Si nadie la configura, los emails no se mandan.
RESEND_API_KEY=
EMAIL_FROM="Hooks Analytics <onboarding@resend.dev>"
EMAIL_REPLY_TO=

# =====================================================
# Observability (opcional)
# =====================================================
# Sentry — sin DSN, el módulo es no-op. Conseguilo en sentry.io.
SENTRY_DSN=

# =====================================================
# MCP server (opcional, solo si vas a correr el MCP stdio aparte)
# =====================================================
MCP_DEFAULT_AUTHOR_EMAIL=lucas@hooks.com.ar
